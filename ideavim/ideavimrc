let g:WhichKeyDesc_file_recent = "<leader>fr archivos recientes"

let g:WhichKeyDesc_search      = "<leader>s  +buscar"
let g:WhichKeyDesc_search_grep = "<leader>sg buscar texto en el proyecto"

let g:WhichKeyDesc_code        = "<leader>c  +código"
let g:WhichKeyDesc_code_action = "<leader>ca quick fix"
let g:WhichKeyDesc_code_rename = "<leader>cr renombrar"
let g:WhichKeyDesc_code_format = "<leader>cf formatear"

let g:WhichKeyDesc_buffer       = "<leader>b  +pestañas"
let g:WhichKeyDesc_buffer_close = "<leader>bd cerrar pestaña"

let g:WhichKeyDesc_test     = "<leader>t  +correr"
let g:WhichKeyDesc_test_run = "<leader>tt correr esta clase"

let g:WhichKeyDesc_debug            = "<leader>d  +debug"
