" ============================================================
"  IdeaVim — lo primordial. Sumar de a poco, no de golpe.
"
"  OJO: en vimscript NO se puede comentar al final de un "map".
"  El texto después del <Action> queda pegado al mapeo y lo rompe.
"  Los comentarios van SIEMPRE en su propia línea.
" ============================================================

" Espacio como leader, igual que LazyVim (IdeaVim usa "\" por default).
let mapleader = " "

" "J" une líneas de forma inteligente según el lenguaje.
set ideajoin

" unnamedplus = registro "+", el clipboard real de Ctrl+C/Ctrl+V, igual que
" tu nvim. ideaput hace que al pegar se reindente y se agreguen los imports.
set clipboard+=unnamedplus,ideaput

" Cursor siempre centrado, como scrolloff=999 en tu options.lua.
set scrolloff=999

" Sin wrap de líneas largas.
set nowrap

" Numeración híbrida: absoluta en la línea actual, relativa en el resto.
set number
set relativenumber

" Búsqueda como LazyVim: resalta mientras tipeás e ignora mayúsculas,
" salvo que vos escribas alguna (ahí sí distingue).
set incsearch
set hlsearch
set ignorecase
set smartcase

" En un refactor te deja en modo normal de vim, no en el modo select del IDE.
set idearefactormode=keep

" ---------- Plugins que vienen dentro de IdeaVim ----------

" ys/cs/ds para envolver, cambiar y borrar comillas y paréntesis.
set surround

" Text objects inteligentes: ci( va{ etc.
set mini-ai

" gcc comenta la línea, gc + movimiento comenta el bloque.
set commentary

" Destella lo que acabás de copiar con y.
set highlightedyank

" j/k/gg/G funcionan dentro del panel de proyecto.
set NERDTree

" ---------- which-key (plugin aparte, del Marketplace) ----------

set which-key

" Sin esto el popup se va al segundo y no llegás a leerlo.
" OJO: con notimeout, un atajo que sea prefijo de otro NUNCA dispara solo.
set notimeout

" ============================================================
"  Atajos
" ============================================================

" Ir a la definición de lo que está bajo el cursor.
map gd <Action>(GotoDeclaration)

" Ver todos los lugares donde se usa.
map gr <Action>(FindUsages)

" Documentación flotante.
map K <Action>(QuickJavaDoc)

" Saltar al siguiente error.
map ]d <Action>(GotoNextError)

" Saltar al error anterior.
map [d <Action>(GotoPreviousError)

" Pestaña anterior / siguiente.
map <S-h> <Action>(PreviousTab)
map <S-l> <Action>(NextTab)

" Guardar todo.
map <C-s> <Action>(SaveAll)

" Panel de proyecto (árbol de archivos).
map <leader>e <Action>(ActivateProjectToolWindow)

" Terminal integrada.
map <C-/> <Action>(ActivateTerminalToolWindow)

" Buscar archivo por nombre.
map <leader>ff <Action>(GotoFile)

" Archivos recientes.
map <leader>fr <Action>(RecentFiles)

" Buscar texto en todo el proyecto.
map <leader>sg <Action>(FindInPath)

" Quick fix / sugerencia de arreglo.
map <leader>ca <Action>(ShowIntentionActions)

" Renombrar en todo el proyecto.
map <leader>cr <Action>(RenameElement)

" Formatear el archivo.
map <leader>cf <Action>(ReformatCode)

" Cerrar la pestaña actual.
map <leader>bd <Action>(CloseContent)

" Correr la clase actual.
map <leader>tt <Action>(RunClass)

" Poner o sacar un breakpoint.
map <leader>db <Action>(ToggleLineBreakpoint)

" Arrancar el debug.
map <leader>dc <Action>(Debug)

" ============================================================
"  Descripciones para which-key
"  Esto es lo que se lee en el popup: sin esto muestra el nombre
"  crudo de la acción de IntelliJ, que no dice nada.
" ============================================================

